{
  "name": "civil-server",
  "version": "2.0.1",
  "description": "an extensible server component that can be part of other civic tech projects",
  "main": "dist/index.js",
  "scripts": {
    "start": "node --max_old_space_size=460 dist/start.js",
    "test": "jest",
    "test:coverage": "npm test -- --coverage",
    "test:watch": "npm test -- --watch",
    "dbtest": "node --inspect-brk node_modules/jest/bin/jest.js --runInBand --config ./jest-db.config.js --runTestsByPath",
    "cypress": "cypress open",
    "cypress:headless": "cypress run --headless --browser chrome",
    "mongo:delete-user": "bash -c 'mongo --eval \"db.users.remove({email: \\\"$0\\\"})\"'",
    "svgr": "svgr --icon --filename-case kebab assets/svg --out-dir app/svgr",
    "transpile": "babel app --ignore **/__tests__ --out-dir dist --source-maps",
    "hot-transpile": "babel --watch app --ignore **/__tests__ --out-dir dist --source-maps",
    "hot-server": "nodemon --inspect dist/start.js",
    "hot-server-no-inspect": "nodemon dist/start.js",
    "hot-client": "webpack-dev-server --config webpack-dev.config.js --devtool source-map --host 0.0.0.0",
    "prepare": "bash build.sh",
    "packbuild": "webpack --config webpack-prod.config.js",
    "dev": "echo \"these delays need to be kept up to date\" && concurrently -k \"npm run hot-transpile\" \"sleep 20 && npm run hot-server\" \"sleep 15 && npm run hot-client\"",
    "dev-no-inspect": "echo \"these delays need to be kept up to date\" && concurrently -k \"npm run hot-transpile\" \"sleep 20 && npm run hot-server-no-inspect\" \"sleep 15 && npm run hot-client\"",
    "link-civil-client": "echo \"use this to link this repo with ../civil-client for testing without pushing it to GitHub\" && node link-civil-client.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnCiv/civil-server.git"
  },
  "author": "David Fridley",
  "license": "SEE LICENSE IN LICENSE.txt",
  "bugs": {
    "url": "https://github.com/EnCiv/civil-server/issues"
  },
  "homepage": "https://github.com/EnCiv/civil-server#readme",
  "optionalDependencies": {
    "@shelf/jest-mongodb": "^6.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "concurrently": "^10.0.4",
    "cypress": "^15.20.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.9",
    "semver": "^7.8.5",
    "supertest": "^7.1.0",
    "webpack-dev-server": "^6.0.0"
  },
  "peerDependencies": {
    "civil-client": "github:EnCiv/civil-client#update2026"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/plugin-transform-object-rest-spread": "^8.0.1",
    "@babel/plugin-transform-react-inline-elements": "^8.0.1",
    "@babel/plugin-transform-regenerator": "^8.0.2",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "babel-loader": "^10.1.1",
    "webpack": "^5.65.0",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@enciv/mongo-collections": "^0.0.5",
    "@getbrevo/brevo": "^6.0.2",
    "@jest/globals": "^30.4.1",
    "@sap_oss/node-socketio-stream": "^1.0.8",
    "assert": "^2.1.0",
    "bcrypt": "^6.0.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "classnames": "^2.5.1",
    "compression": "^1.7.4",
    "constants-browserify": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "core-js": "^3.50.0",
    "device": "^0.3.12",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "is-email": "^1.0.2",
    "joi": "^18.2.3",
    "lodash": "^4.17.21",
    "marked": "^18.0.9",
    "mongodb": "^7.5.0",
    "nodemailer": "^9.0.4",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-jss": "^10.10.0",
    "sniffr": "^1.4.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stream-browserify": "^3.0.0"
  },
  "bin": {
    "do-civil": "./app/tools/do-civil.sh",
    "logwatch": "./dist/tools/logwatch.js",
    "mongo-id": "./dist/tools/mongo-id.js",
    "react-directory-indexer": "./dist/tools/react-directory-indexer.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "mongodb-memory-server@10.3.0": true,
    "mongodb-memory-server@11.2.0": true,
    "@swc/core@1.15.47": true,
    "bcrypt@6.0.0": true,
    "core-js@3.50.0": true,
    "cypress@15.20.0": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
